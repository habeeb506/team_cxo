# Server
NODE_ENV=development
PORT=4000
API_VERSION=v1

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/cxodb

# CORS
CORS_ORIGIN=http://localhost:3000

# Access gate (see middlewares/hostAllowlist.middleware.js): only
# requests whose Host header matches one of these (comma-separated,
# case-insensitive, port included when non-default) are served at all.
# Leave blank to disable this gate. Update this when you move the
# backend to a real hostname.
ALLOWED_HOSTS=localhost:4000,127.0.0.1:4000

# Auth (email-OTP login, see routes/v1/auth.routes.js)
# Generate a real random 32+ byte value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN_SECONDS=28800
OTP_EXPIRES_IN_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=30
# true means OTPs are only logged, not emailed -- see SMTP_* below. Set
# to false once SMTP_* is filled in with real credentials.
OTP_DEV_MODE=true

# SMTP (real OTP email delivery, see utils/mailer.js) -- only needed once
# OTP_DEV_MODE=false. Works with any standard SMTP provider, e.g. Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-address@gmail.com
#   SMTP_PASS=<a Gmail "App Password", not your normal password --
#              generate one at https://myaccount.google.com/apppasswords>
# Or Outlook/Office365: SMTP_HOST=smtp.office365.com, same port/secure.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if left blank. Can be "Display Name <addr>".
SMTP_FROM=

# Temporary: keep echoing the OTP in the request-otp response (and
# showing it on the login page) even after real SMTP delivery is turned
# on, so you can confirm login still works without checking an inbox.
# Set to false once you trust real delivery is working.
OTP_ECHO_IN_RESPONSE=true

# Logging
LOG_LEVEL=info
